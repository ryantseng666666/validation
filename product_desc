// OrderInfoController.java
@RestController
@RequestMapping("/api/order-info")
@RequiredArgsConstructor
public class OrderInfoController {
    private final OrderInfoService orderInfoService;

    @PostMapping("/process-monthly-ai")
    public String processMonthlyAI(@RequestParam String monthDate) {
        return orderInfoService.processMonthlyData(monthDate);
    }

    @PostMapping("/check-monthly-duplicates")
    public String checkMonthlyDuplicates(@RequestParam String monthDate) {
        return orderInfoService.checkDuplicates(monthDate);
    }
}

// OrderInfoService.java
