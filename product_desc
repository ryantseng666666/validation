<script>
export default {
  data() {
    return {
      aiProcessing: false,
      currentMonth: '' // 格式: yyyy-MM
    };
  },
  methods: {
    async handleAIProcess() {
      this.aiProcessing = true;
      try {
        const res = await this.$axios.post('/api/order-info/process-monthly-ai', {
          params: { monthDate: this.currentMonth }
        });
        this.$message.success(res.data === 'success' ? '处理成功' : '处理失败');
      } catch (error) {
        this.$message.error('请求失败: ' + error.message);
      } finally {
        this.aiProcessing = false;
      }
    }
  }
};
</script>

